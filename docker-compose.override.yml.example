# Local Development Override Example
# Copy this file to docker-compose.override.yml (`cp docker-compose.override.yml.example docker-compose.override.yml`)
# Docker Compose automatically loads overrides from docker-compose.override.yml during local development.

services:
  server:
    environment:
      NODE_ENV: development
      ENFORCE_HTTPS: "false"
    ports:
      - "3000:3000"
    volumes:
      - ./apps/server/src:/app/src
      - server_uploads:/app/uploads

  admin:
    environment:
      NODE_ENV: development
    ports:
      - "3001:3001"
    volumes:
      - ./apps/admin/src:/app/src
      - ./apps/admin/public:/app/public

  postgres:
    ports:
      - "5432:5432"

  redis:
    ports:
      - "6379:6379"
