# ============================================================================
# BexieMart self-hosted stack (docker-compose) — environment template
#
#   cp .env.example .env      then fill in / generate the values below.
#
# scripts/deploy.sh | deploy.ps1 will auto-generate the four REQUIRED secrets
# with strong random values if they are missing when you deploy.
# ============================================================================

# --- REQUIRED infrastructure secrets -----------------------------------------
# Generate each with:  openssl rand -hex 32
POSTGRES_PASSWORD=
REDIS_PASSWORD=
BETTER_AUTH_SECRET=
JWT_SECRET=

# --- Postgres / Redis wiring (defaults are fine for the compose stack) -------
POSTGRES_USER=bexiemart
POSTGRES_DB=bexiemart

# --- Server application settings ---------------------------------------------
BETTER_AUTH_URL=https://your-domain.com
# Comma-separated origins allowed to call the API (include your admin origin):
CORS_ORIGIN=https://admin.bexiemart.com,bexiemart://,exp://
# HTTPS redirect middleware on the API. Leave true in production:
ENFORCE_HTTPS=true

# --- Third-party services (empty = feature disabled / fails closed) ----------
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
SENTRY_DSN=
POSTHOG_API_KEY=

# --- Admin portal build-time config ------------------------------------------
NEXT_PUBLIC_API_URL=/api/v1
